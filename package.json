{
  "name": "demo-nuxt",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "copies": "gqlmd graphql-to-doc:markdown && node -e \"require('node:fs').cpSync('.markdown-copies', 'public', { recursive: true })\"",
    "build": "pnpm run copies && nuxi build",
    "dev": "pnpm run copies && nuxi dev",
    "generate": "pnpm run copies && nuxi generate",
    "preview": "nuxi preview",
    "test:visual": "playwright test",
    "postinstall": "nuxi prepare"
  },
  "dependencies": {
    "@graphql-markdown/formatters": "^1.3.0",
    "@graphql-markdown/nuxt-theme": "^0.3.0",
    "@graphql-markdown/printer-legacy": "^1.21.0",
    "@nuxt/content": "^3.17.0",
    "@nuxt/ui": "^4.12.2",
    "better-sqlite3": "^13.2.0",
    "nuxt": "^4.6.4",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.0",
    "@graphql-markdown/cli": "^1.3.0",
    "@graphql-markdown/graphql": "^1.3.6",
    "@graphql-tools/url-loader": "^10.0.9",
    "@iconify-json/lucide": "^1.2.156",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "graphql": "^17.1.0",
    "graphql-config": "^6.0.0",
    "prettier": "^3.10.1",
    "serve": "^14.2.8"
  }
}
